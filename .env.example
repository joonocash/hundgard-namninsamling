# Databas (SQLite-fil). I produktion via Docker: file:/app/data/prod.db
DATABASE_URL="file:./dev.db"

# Publik URL till sajten (används i bekräftelsemejl och QR-koden)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mål för antal underskrifter
SIGNATURE_GOAL=1000

# SMTP för bekräftelsemejl
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Hundgården <no-reply@example.com>"

# Admin (Basic Auth för /admin och /admin/qr)
ADMIN_USER=""
ADMIN_PASS=""

# Slumpmässig, hemlig sträng som saltar den hashade IP-adressen (valfri egen sträng)
IP_HASH_SALT="byt-ut-mig"
