generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Signature {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  postnummer          String
  verificationToken   String    @unique
  verificationExpires DateTime
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  ipHash              String?

  @@index([verifiedAt])
}
